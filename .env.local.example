# Local Development Environment Variables
# Copy this file to .env.local and update with your values

# Database URL
# Option 1: SQLite (simpler for local dev)
DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (same as production)
# DATABASE_URL="postgresql://user:password@localhost:5432/stock_rating"

# VNStock Service URL
# For local dev, use localhost
NEXT_PUBLIC_VNSTOCK_SERVICE_URL="http://localhost:8000"

# For production, use Render service URL
# NEXT_PUBLIC_VNSTOCK_SERVICE_URL="https://stock-rating-api.onrender.com"
